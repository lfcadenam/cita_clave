# =============================================================================
# Cita Clave — Root Monorepo .gitignore
# =============================================================================

# Dependencies
**/node_modules/
**/vendor/

# Environment Variables & Secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.docker.example
**/auth.json

# Databases & SQLite
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
**/database/database.sqlite*

# Compiled & Build Output
**/dist/
**/public/build/
**/public/hot/
**/public/storage
**/public/storage/*
**/storage/app/public/*
!**/storage/app/public/.gitignore
**/storage/framework/cache/*
!**/storage/framework/cache/.gitignore
**/storage/framework/sessions/*
!**/storage/framework/sessions/.gitignore
**/storage/framework/testing/*
!**/storage/framework/testing/.gitignore
**/storage/framework/views/*
!**/storage/framework/views/.gitignore
**/storage/logs/*.log
!**/storage/logs/.gitignore
**/storage/*.key
**/.phpunit.result.cache

# Angular Cache & Temp
**/.angular/
**/.angular/cache/
**/tmp/
**/out-tsc/

# IDE, OS & System Files
.idea/
.vscode/
*.sublime-workspace
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*