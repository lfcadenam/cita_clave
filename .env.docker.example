# ==============================================================================
# CITA CLAVE SAAS - VARIABLES DE ENTORNO PARA DOCKER & PRODUCCIÓN (VPS)
# DOMINIO OFICIAL: https://labellenailsbog.com
# ==============================================================================

APP_NAME="La Belle Nails Bogotá"
APP_ENV=production
APP_KEY=base64:GENERA_TU_KEY_CON_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://labellenailsbog.com
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Configuración de Dominio y Proxy Inverso Docker
DOMAIN_NAME=labellenailsbog.com
ADMIN_EMAIL=admin@nuvex-tecnologia.com
PROXY_NETWORK=elan_default
HTTP_PORT=80
HTTPS_PORT=443

# Base de Datos MySQL (Contenedor Docker: db)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=citaclave
DB_USERNAME=citaclave_user
DB_PASSWORD=CambiaEstaClaveDbPorUnaSegura2026!
DB_ROOT_PASSWORD=CambiaEstaClaveRootPorUnaSegura2026!

# Sesiones, Cache y Colas
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Almacenamiento de archivos (Comprobantes Nequi, fotos de servicios)
FILESYSTEM_DISK=public

# Credenciales de Salón y Nequi Directo
NEQUI_HOLDER_NAME="Paola Andrea Aguilera Camacho"
NEQUI_ACCOUNT_NUMBER="3103248385"
NEQUI_DOCUMENT_ID="1.020.304.506"
INITIAL_SALON_ADMIN_PASSWORD="Paola2026!LaBelle"

# Correo Electrónico (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@labellenailsbog.com
MAIL_PASSWORD=tu_password_smtp
MAIL_FROM_ADDRESS="notificaciones@labellenailsbog.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pasarela de Pagos Bold (Opcional - Producción)
BOLD_API_KEY=
BOLD_SECRET_KEY=
BOLD_INTEGRITY_KEY=
BOLD_WEBHOOK_SECRET=
BOLD_ENVIRONMENT=production