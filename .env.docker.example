# ==============================================================================
# CITA CLAVE SAAS - VARIABLES DE ENTORNO PARA DOCKER & PRODUCCIÓN (VPS)
# ==============================================================================

APP_NAME="Cita Clave"
APP_ENV=production
APP_KEY=base64:GENERA_TU_KEY_CON_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Puertos expuestos en el servidor VPS
HTTP_PORT=80
HTTPS_PORT=443

# Base de Datos MySQL (Contenedor Docker: db)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=citaclave
DB_USERNAME=citaclave_user
DB_PASSWORD=CambiaEstaClaveDbPorUnaSegura2026!
DB_ROOT_PASSWORD=CambiaEstaClaveRootPorUnaSegura2026!

# Sesiones, Cache y Colas
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Almacenamiento de archivos (Comprobantes Nequi, fotos de servicios)
FILESYSTEM_DISK=public

# Correo Electrónico (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@tu-dominio.com
MAIL_PASSWORD=tu_password_smtp
MAIL_FROM_ADDRESS="notificaciones@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pasarela de Pagos Bold (Opcional - Producción)
BOLD_API_KEY=
BOLD_SECRET_KEY=
BOLD_INTEGRITY_KEY=
BOLD_WEBHOOK_SECRET=
BOLD_ENVIRONMENT=production